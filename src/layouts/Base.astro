---
import '../styles/global.css';
import { site, nav } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = 'Senior Data Engineer focused on data infrastructure and applied AI: pipelines, databases, lakehouses, RAG and agent systems.',
} = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const here = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0c0f" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
  </head>
  <body>
    <a class="skip mono" href="#main">Skip to content</a>
    <header class="site-nav">
      <div class="wrap bar">
        <a class="logo" href="/"><span class="mark" aria-hidden="true"></span>{site.name}</a>
        <nav aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li>
                <a href={item.href} aria-current={here.startsWith(item.href) ? 'page' : undefined}>
                  <span class="n">{item.n}</span>{item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap mono muted">
        <span>{site.name} · {site.location}</span>
        <span>Built with Astro · hosted on S3 + CloudFront</span>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 16px;
    top: 8px;
    z-index: 20;
    background: var(--color-accent);
    color: var(--color-on-accent);
    padding: 8px 12px;
  }
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-line);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    justify-content: space-between;
    align-items: center;
    padding-block: 14px;
  }
  .logo {
    font-stretch: 125%;
    font-weight: 900;
    font-size: 18px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    display: inline-flex;
    gap: 8px;
    align-items: center;
    color: var(--color-ink);
    text-decoration: none;
  }
  .mark {
    width: 18px;
    height: 18px;
    background: var(--color-accent);
    clip-path: polygon(0 0, 100% 0, 100% 60%, 60% 100%, 0 100%);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
  }
  li a {
    color: var(--color-muted);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  li a:hover {
    color: var(--color-ink);
  }
  li a .n {
    color: var(--color-accent);
    margin-right: 4px;
  }
  li a[aria-current='page'] {
    color: var(--color-ink);
    box-shadow: 0 2px 0 var(--color-accent);
  }
  main {
    min-height: 70vh;
  }
  .site-foot {
    margin-top: 72px;
    border-top: 1px solid var(--color-line);
  }
  .site-foot .wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    justify-content: space-between;
    padding-block: 24px 40px;
  }
</style>
