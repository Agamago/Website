---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { site } from '../../data/site';

const skills = [
  { group: 'Core engineering', items: ['Python', 'SQL / T-SQL', 'Go', 'Relational modeling', 'SQL Server', 'PostgreSQL', 'Aurora', 'BigQuery'] },
  { group: 'Data & infrastructure', items: ['Airflow', 'ETL / ELT', 'Idempotent pipelines', 'Query tuning', 'FastAPI', 'Docker', 'AWS', 'GCP'] },
  { group: 'Applied AI', items: ['RAG agents', 'Vector search', 'LangChain', 'FAISS', 'LLM apps', 'Computer-vision inference'] },
  { group: 'Exploring', items: ['Iceberg', 'Trino', 'dbt', 'MLflow', 'Kubernetes', 'Terraform', 'Knowledge graphs', 'MCP'] },
];
const timeline = [
  { when: '2024 – now', where: 'HRL Laboratories', what: 'Engineer III (promoted from Engineer II). First data engineer and sole backend engineer.' },
  { when: '2024', where: 'Summit Advisory Team', what: 'Data consultant. BigQuery models and Looker dashboards for a cloud migration.' },
  { when: '2021 – 2024', where: 'Katch Entertainment Data', what: 'Senior Backend Engineer, earlier Database Engineer. Data backend, APIs and a production RAG agent.' },
];
---
<Base title="About" description={`About ${site.name}: ${site.title}, data infrastructure and applied AI.`}>
  <PageHead path={[{ label: 'about' }]} title="About" />
  <section class="wrap about">
    <div class="panel crop headshot"><span class="mono muted">Headshot · 4:5</span></div>
    <div class="story">
      <span class="mono ink">story <span class="sample">placeholder</span></span>
      <p class="lede">
        I'm a {site.title.toLowerCase()} in {site.location}. I build the platforms that move and store data, and the AI systems that
        sit on top of them. I'm working toward an M.S. in Artificial Intelligence at Johns Hopkins.
      </p>
      <div class="row">
        <a class="btn btn-primary" href={site.resume}>Download résumé</a>
        <a class="btn btn-ghost" href="/contact/">Get in touch</a>
      </div>
    </div>
  </section>

  <section class="wrap sub">
    <h2 class="h-section">Path</h2>
    <ol class="timeline">
      {timeline.map((t) => (
        <li><span class="mono muted">{t.when}</span><b>{t.where}</b><p>{t.what}</p></li>
      ))}
    </ol>
  </section>

  <section class="wrap sub">
    <h2 class="h-section">Skills map</h2>
    <div class="skills">
      {skills.map((s) => (
        <div class="panel">
          <span class="mono ink">{s.group}</span>
          <div class="tags">{s.items.map((i) => <span class="tag">{i}</span>)}</div>
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .about {
    display: grid;
    gap: 32px;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 800px) {
    .about {
      grid-template-columns: 300px minmax(0, 1fr);
    }
  }
  .headshot {
    aspect-ratio: 4 / 5;
    max-width: 300px;
    display: grid;
    place-items: center;
    background: repeating-linear-gradient(135deg, var(--color-surface) 0 12px, var(--color-surface-2) 12px 24px);
  }
  .story {
    display: grid;
    gap: 20px;
    align-content: start;
  }
  .sub {
    padding-top: 48px;
    display: grid;
    gap: 16px;
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--color-line);
    display: grid;
    gap: 20px;
  }
  .timeline li {
    padding-left: 18px;
    position: relative;
    display: grid;
    gap: 2px;
  }
  .timeline li::before {
    content: '';
    position: absolute;
    left: -6px;
    top: 4px;
    width: 10px;
    height: 10px;
    background: var(--color-accent);
  }
  .timeline b {
    font-stretch: 112%;
    font-weight: 760;
    font-size: 18px;
    text-transform: uppercase;
  }
  .timeline p {
    margin: 0;
    color: var(--color-muted);
  }
  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 12px;
  }
  .skills .panel {
    padding: 16px;
    display: grid;
    gap: 10px;
    align-content: start;
  }
</style>
