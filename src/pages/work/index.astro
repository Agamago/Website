---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { workProjects } from '../../data/site';
---
<Base title="Work" description="Case studies from production data and AI systems: problem, architecture, stack and role.">
  <PageHead
    path={[{ label: 'work' }]}
    title="Work"
    lede="Case studies from real jobs, kept high level: the problem, the architecture, the stack and my role."
  />
  <section class="wrap">
    <div class="grid-cards">
      {workProjects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>
</Base>
