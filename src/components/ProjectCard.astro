---
import type { Project } from '../data/site';
interface Props {
  project: Project;
  featured?: boolean;
}
const { project: p, featured = false } = Astro.props;
const Tag = p.href ? 'a' : 'div';
---
<Tag class:list={['panel', 'card', { crop: featured }]} href={p.href}>
  <div class="top">
    <span class="mono ink">{p.id}</span>
    <span class:list={['mono', 'status', { off: p.status !== 'live' }]}>{p.status === 'live' ? `${p.kind} · live` : 'Coming soon'}</span>
  </div>
  <h3>{p.title}</h3>
  <p>{p.blurb}</p>
  <div class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
</Tag>
